.KEY RUNDIR/A,MACHINE/A
.BRA [
.KET ]
; DeckCraft package check with apkg from a local index. Put into RAM:t: apkg (for this system),
; dc.zip (the package), idx.json (a test index naming it), hello.pptx, steps-pkg.json,
; steps-pkg2.json, run-use. Then: Execute RAM:t/run-pkg <results directory> <machine name>.
; Everything stays under RAM:.
FailAt 21
Protect RAM:t/apkg +e
MakeDir RAM:pk
MakeDir RAM:pk/cache
Copy RAM:t/dc.zip RAM:pk/cache/deckcraft.zip
RAM:t/apkg --version >[RUNDIR]/apkg-version.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json show deckcraft >[RUNDIR]/show.txt
Echo $RC >[RUNDIR]/show.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json install deckcraft --yes >[RUNDIR]/install.txt
Echo $RC >[RUNDIR]/install.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json verify deckcraft >[RUNDIR]/verify.txt
Echo $RC >[RUNDIR]/verify.rc
List RAM:pk ALL >[RUNDIR]/installed.txt
Execute RAM:t/run-use [RUNDIR]
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json remove deckcraft --yes >[RUNDIR]/remove.txt
Echo $RC >[RUNDIR]/remove.rc
List RAM:pk ALL >[RUNDIR]/after-remove.txt
Echo "done" >[RUNDIR]/pkg-done.txt
