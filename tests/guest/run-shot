; DeckCraft GUI screenshot runs RUN: three starts in a row, memory around them.
; Results: RESULTS:RUN-*
FailAt 21
Protect RAM:dc/DeckCraft +e
Stack 4000000
SetEnv RUST_LOG info
SetEnv DECKCRAFT_CONFIG_DIR RAM:dc/data
Echo "RUN start" >RESULTS:RUN-start.txt
Avail FLUSH >RESULTS:RUN-avail0.txt
Date >RESULTS:RUN-date1.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-1.txt
RAM:dc/DeckCraft --screenshot RAM:dc/shot1.png --screenshot-frames 8 RAM:dc/hello.pptx
Echo $RC >RESULTS:RUN-shot1.rc
Date >RESULTS:RUN-date2.txt
Avail FLUSH >RESULTS:RUN-avail1.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-2.txt
RAM:dc/DeckCraft --screenshot RAM:dc/shot2.png --screenshot-frames 8 --window 800x560
Echo $RC >RESULTS:RUN-shot2.rc
Avail FLUSH >RESULTS:RUN-avail2.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-3.txt
RAM:dc/DeckCraft --screenshot RAM:dc/shot3.png --screenshot-frames 8 RAM:dc/hello.pptx
Echo $RC >RESULTS:RUN-shot3.rc
Date >RESULTS:RUN-date3.txt
Avail FLUSH >RESULTS:RUN-avail3.txt
List RAM:dc/data ALL >RESULTS:RUN-data.txt
Copy RAM:dc/shot1.png RESULTS:RUN-shot1.png
Copy RAM:dc/shot2.png RESULTS:RUN-shot2.png
Copy RAM:dc/shot3.png RESULTS:RUN-shot3.png
Copy RAM:dc/log-1.txt RESULTS:RUN-log-1.txt
Copy RAM:dc/log-2.txt RESULTS:RUN-log-2.txt
Copy RAM:dc/log-3.txt RESULTS:RUN-log-3.txt
Echo "RUN shot done" >RESULTS:RUN-shot-done.txt
