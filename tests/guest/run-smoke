.KEY RUNDIR/A
.BRA [
.KET ]
; DeckCraft smoke run: CLI, two GUI starts, a scripted edit saved and read back.
; Unpack the payload to RAM:dc, then: Execute RAM:dc/run-smoke <results directory>
FailAt 21
Protect RAM:dc/deckcraft-cli +e
Protect RAM:dc/DeckCraft +e
SetEnv RUST_LOG info
SetEnv DECKCRAFT_CONFIG_DIR RAM:dc/data
Echo "start" >[RUNDIR]/start.txt
RAM:dc/deckcraft-cli --version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:dc/deckcraft-cli info RAM:dc/hello.pptx >[RUNDIR]/cli-info.txt
Echo $RC >[RUNDIR]/cli-info.rc
RAM:dc/deckcraft-cli render RAM:dc/hello.pptx --slide 0 --scale 1 RAM:dc/s1.png >[RUNDIR]/cli-render.txt
Echo $RC >[RUNDIR]/cli-render.rc
RAM:dc/deckcraft-cli convert RAM:dc/hello.pptx RAM:dc/out.pdf >[RUNDIR]/cli-pdf.txt
Echo $RC >[RUNDIR]/cli-pdf.rc
RAM:dc/deckcraft-cli convert RAM:dc/hello.pptx RAM:dc/out.md >[RUNDIR]/cli-md.txt
Echo $RC >[RUNDIR]/cli-md.rc
RAM:dc/deckcraft-cli run --in RAM:dc/hello.pptx --cmd "slide.new={*"layout*":*"titleOnly*",*"title*":*"Written on AROS*"}" --save RAM:dc/edited.pptx >[RUNDIR]/cli-run.txt
Echo $RC >[RUNDIR]/cli-run.rc
; Save over the file just written: an existing destination must be replaced.
RAM:dc/deckcraft-cli run --in RAM:dc/edited.pptx --cmd "slide.new={*"title*":*"Second save*"}" --save RAM:dc/edited.pptx >[RUNDIR]/cli-run2.txt
Echo $RC >[RUNDIR]/cli-run2.rc
RAM:dc/deckcraft-cli convert RAM:dc/edited.pptx RAM:dc/edited.md >[RUNDIR]/cli-md2.txt
Echo $RC >[RUNDIR]/cli-md2.rc
RAM:dc/deckcraft-cli mcp <RAM:dc/mcp-in.txt >[RUNDIR]/cli-mcp.txt
Echo $RC >[RUNDIR]/cli-mcp.rc
Echo "cli done" >[RUNDIR]/cli-done.txt
; GUI: version, a start with a file, one with the sample, and the scripted edit.
RAM:dc/DeckCraft --version >[RUNDIR]/gui-version.txt
Echo $RC >[RUNDIR]/gui-version.rc
Avail FLUSH >[RUNDIR]/avail0.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-1.txt
RAM:dc/DeckCraft --window 900x560 --screenshot RAM:dc/shot1.png --screenshot-frames 8 RAM:dc/hello.pptx
Echo $RC >[RUNDIR]/shot1.rc
Avail FLUSH >[RUNDIR]/avail1.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-2.txt
RAM:dc/DeckCraft --window 900x560 --sample --screenshot RAM:dc/shot2.png --screenshot-frames 8
Echo $RC >[RUNDIR]/shot2.rc
Avail FLUSH >[RUNDIR]/avail2.txt
SetEnv DECKCRAFT_LOG RAM:dc/log-3.txt
RAM:dc/DeckCraft --window 900x560 --test-steps RAM:dc/steps.json RAM:dc/hello.pptx
Echo $RC >[RUNDIR]/steps.rc
Avail FLUSH >[RUNDIR]/avail3.txt
RAM:dc/deckcraft-cli convert RAM:dc/gui-saved.pptx RAM:dc/gui-saved.md >[RUNDIR]/gui-saved-md.txt
Echo $RC >[RUNDIR]/gui-saved-md.rc
List RAM:dc ALL >[RUNDIR]/list.txt
Copy RAM:dc/s1.png [RUNDIR]/s1.png
Copy RAM:dc/out.pdf [RUNDIR]/out.pdf
Copy RAM:dc/out.md [RUNDIR]/out.md
Copy RAM:dc/edited.md [RUNDIR]/edited.md
Copy RAM:dc/shot1.png [RUNDIR]/shot1.png
Copy RAM:dc/shot2.png [RUNDIR]/shot2.png
Copy RAM:dc/steps-a.png [RUNDIR]/steps-a.png
Copy RAM:dc/steps-b.png [RUNDIR]/steps-b.png
Copy RAM:dc/log-1.txt [RUNDIR]/log-1.txt
Copy RAM:dc/log-2.txt [RUNDIR]/log-2.txt
Copy RAM:dc/log-3.txt [RUNDIR]/log-3.txt
Copy RAM:dc/gui-saved.md [RUNDIR]/gui-saved.md
Echo "done" >[RUNDIR]/done.txt
