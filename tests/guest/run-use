.KEY RUNDIR/A
.BRA [
.KET ]
; The installed DeckCraft in RAM:pk used twice: the scripted session on hello.pptx (a new slide,
; Save As, undo, redo, Save, quit), its file read back by the CLI, then a start without a file.
FailAt 21
SetEnv RUST_LOG info
RAM:pk/DeckCraft/deckcraft-cli --version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:pk/DeckCraft/DeckCraft --version >[RUNDIR]/gui-version.txt
RAM:pk/DeckCraft/DeckCraft --window 900x560 --test-steps RAM:t/steps-pkg.json RAM:t/hello.pptx
Echo $RC >[RUNDIR]/gui.rc
RAM:pk/DeckCraft/deckcraft-cli convert RAM:t/pkg-saved.pptx RAM:t/pkg-saved.md >[RUNDIR]/saved-md.txt
Echo $RC >[RUNDIR]/saved-md.rc
Copy RAM:t/pkg-saved.md [RUNDIR]/pkg-saved.md
RAM:pk/DeckCraft/DeckCraft --window 900x560 --test-steps RAM:t/steps-pkg2.json
Echo $RC >[RUNDIR]/gui2.rc
List RAM:pk/DeckCraft/DeckCraftData ALL >[RUNDIR]/data.txt
Copy RAM:pk/DeckCraft/DeckCraftData/DeckCraft.log [RUNDIR]/DeckCraft.log
Copy RAM:pk/DeckCraft/DeckCraftData/ui.json [RUNDIR]/ui.json
Copy RAM:pk/DeckCraft/BUILD.txt [RUNDIR]/BUILD.txt
Copy RAM:t/pkg-b.png [RUNDIR]/pkg-b.png
