From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Fri, 20 Nov 2026 18:35:53 +0100
Subject: [PATCH] AROS: the CLI turns DOS volume requesters off

chrono reads /etc/localtime for the local time, which names a volume "etc" that does not exist on AROS: deckcraft-cli stopped at a "Please insert volume etc" requester, again after each Cancel (pool v11-1, run 20261120-183106-54863acf). aros-startup's quiet_dos makes DOS return an error instead, as the GUI does; the WordCraft port's CLI does the same.
---
 apps/deckcraft-cli/Cargo.toml  | 2 ++
 apps/deckcraft-cli/src/main.rs | 5 +++++
 2 files changed, 7 insertions(+)

diff --git a/apps/deckcraft-cli/Cargo.toml b/apps/deckcraft-cli/Cargo.toml
index 98125b618cb0b9da125b643c3bfaaa87fcc4874c..0e3180751fcb97a60c9bacc861b2cd1ea31c5d42 100644
--- a/apps/deckcraft-cli/Cargo.toml
+++ b/apps/deckcraft-cli/Cargo.toml
@@ -22,6 +22,8 @@ serde_json = { workspace = true }
 # which AROS's pthread library otherwise waits for forever when the program exits.
 [target.'cfg(target_os = "aros")'.dependencies]
 rayon-core = "1.13"
+# Program start on AROS (from the egui-aros repository, without egui), supplied by the port's build.
+aros-startup = "0.1"
 
 [dev-dependencies]
 zip = { workspace = true }
diff --git a/apps/deckcraft-cli/src/main.rs b/apps/deckcraft-cli/src/main.rs
index ac032b47f0d191a9c17cdbcc5a862ca4f87e14bb..e22a5c7a17f92277bba5227a54639808ca0bb6ed 100644
--- a/apps/deckcraft-cli/src/main.rs
+++ b/apps/deckcraft-cli/src/main.rs
@@ -46,6 +46,11 @@ fn stdout_line(args: std::fmt::Arguments<'_>) -> std::io::Result<()> {
 const AROS_STACK: usize = 8 << 20;
 
 fn main() -> ExitCode {
+    // AROS: Unix-style probes (chrono's /etc/localtime for local time, the /etc and /usr font
+    // folders) name volumes that do not exist; DOS answers them with an error instead of an
+    // "insert volume" requester that stops the command until someone answers it.
+    #[cfg(target_os = "aros")]
+    aros_startup::quiet_dos();
     #[cfg(not(target_os = "aros"))]
     let code = cli_main();
     // An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One
