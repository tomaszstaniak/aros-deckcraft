From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Fri, 20 Nov 2026 18:15:48 +0100
Subject: [PATCH] AROS: FONTS: as the system font folder

The font folder list for systems other than macOS and Windows is Linux's, with fontconfig's files under /etc; in the -nix path mode the AROS build runs in, each folder names a volume (usr, run, etc, ...) and DOS would ask for each one. AROS gets FONTS:, as in the WordCraft and VectorCraft ports.
---
 crates/fonts/src/fontdb.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/crates/fonts/src/fontdb.rs b/crates/fonts/src/fontdb.rs
index e542c8d185ea6ebb381d6aa2c1e8ad8c1443d63d..67b593c42fcdbbf8325d8f15a338d9a42423e7a1 100644
--- a/crates/fonts/src/fontdb.rs
+++ b/crates/fonts/src/fontdb.rs
@@ -629,6 +629,10 @@ pub fn system_font_dirs() -> Vec<std::path::PathBuf> {
             // DeckCraft never ships or needs them.
             dirs.push(l.join("Microsoft\\FontCache\\4\\CloudFonts"));
         }
+    } else if cfg!(target_os = "aros") {
+        // FONTS: in the -nix path mode the program runs in. The Unix folders below would name
+        // volumes that do not exist (usr, run, etc…), each a "Please insert volume" request.
+        dirs.push("/FONTS".into());
     } else {
         dirs.extend(["/usr/share/fonts", "/usr/local/share/fonts"].map(Into::into));
         if let Some(h) = &home {
