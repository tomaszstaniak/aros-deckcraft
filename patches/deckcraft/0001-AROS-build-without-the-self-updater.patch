+            #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
             updates_rt: updates_ui::Runtime::default(),
             pending_copy: None,
             capture: capture::Capture::default(),
@@ -132,7 +132,7 @@ impl SlideApp {
 
     /// Turn on the automatic check for a newer release at start-up (desktop shell only; tests and
     /// the web build never touch the network on their own).
-    #[cfg(not(target_arch = "wasm32"))]
+    #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
     pub fn enable_update_checks(&mut self) {
         updates_ui::enable(self);
     }
@@ -140,7 +140,7 @@ impl SlideApp {
     /// Start the helper of an update that is ready, so that it installs once the process has
     /// exited. The desktop shell calls it in `on_exit`, which ends the process on macOS before the
     /// app is dropped. Later calls do nothing.
-    #[cfg(not(target_arch = "wasm32"))]
+    #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
     pub fn start_pending_update(&mut self) {
         updates_ui::start_pending_update(self);
     }
@@ -229,7 +229,7 @@ impl SlideApp {
         if !self.synthetic_batch_is_live(ctx) {
             self.drain_control(ctx);
             self.poll_opening();
-            #[cfg(not(target_arch = "wasm32"))]
+            #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
             updates_ui::tick(self, ctx);
             // Inbox results are host file bytes and do not need fonts or a painted frame. A
             // window that starts hidden must still apply a file picked before its first UI pass.
@@ -358,7 +358,7 @@ impl SlideApp {
         toast::note_missing_fonts(self);
         toast::show(self, &ctx);
         dialogs::show(self, &ctx);
-        #[cfg(not(target_arch = "wasm32"))]
+        #[cfg(not(any(target_arch = "wasm32", target_os = "aros")))]
         updates_ui::show(self, &ctx);
         menus::palette(self, &ctx);
         for url in std::mem::take(&mut self.pending_urls) {
