From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Tue, 20 Oct 2026 11:09:44 +0200
Subject: [PATCH] deckcraft-cli: own stack and an ending rayon pool on AROS

Problem: an AROS program runs on the stack of whatever starts it (40,960
  bytes in an AROS One Shell, and whatever an MCP client's process creation
  gives); parsing, layout and rendering overrun that. And AROS's pthread
  library joins every thread in its exit handler, so rayon's idle global
  workers (krilla's PDF export, the video decoders) keep a command that used
  them from ever exiting.
Rationale: the command runs on a thread with an 8 MiB stack; its exit code
  returns to the main task (exit() from another thread crashes on ABIv11),
  and the global pool is ended there with the port's patched rayon-core
  (terminate_global_thread_pool), as in the WordCraft and PhotoCraft ports.
Scope: AROS only; other targets run as before.
Upstream-status: local-only.
Verification: built for x86_64 ABIv11; native runs in the port's evidence.
Removal: when AROS programs get a sufficient stack by other means and the
  pthread library no longer waits for pool threads.
---
 Cargo.lock                     |  1 +
 apps/deckcraft-cli/Cargo.toml  |  5 +++++
 apps/deckcraft-cli/src/main.rs | 28 ++++++++++++++++++++++++++++
 3 files changed, 34 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index b37952da527182a2f5a75eb14c4cbb182b8c838c..bd2d9fec304a2a706fa1e4151a6a0762bdcd623d 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -940,6 +940,7 @@ version = "0.8.0"
 dependencies = [
  "deckcraft-engine",
  "deckcraft-mcp",
+ "rayon-core",
  "serde_json",
 ]
 
diff --git a/apps/deckcraft-cli/Cargo.toml b/apps/deckcraft-cli/Cargo.toml
index 898a1fb34ca200dc534545bfbbeba7ef4148f034..94e9dc93fb97b7af5caddda32fe98ea55b901375 100644
--- a/apps/deckcraft-cli/Cargo.toml
+++ b/apps/deckcraft-cli/Cargo.toml
@@ -17,3 +17,8 @@ path = "src/main.rs"
 deckcraft-engine = { workspace = true }
 deckcraft-mcp = { workspace = true }
 serde_json = { workspace = true }
+
+# The patched rayon-core (see the AROS port's crate patches) can end the global pool's threads,
+# which AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
diff --git a/apps/deckcraft-cli/src/main.rs b/apps/deckcraft-cli/src/main.rs
index 5934973ed7b457cd0dc8aedc45602fec1d8b9e96..e7b122c37ac054c378261e0941f47e437e4c274f 100644
--- a/apps/deckcraft-cli/src/main.rs
+++ b/apps/deckcraft-cli/src/main.rs
@@ -24,7 +24,35 @@ macro_rules! outln {
     }};
 }
 
+/// The command thread's stack on AROS (see `main`).
+#[cfg(target_os = "aros")]
+const AROS_STACK: usize = 8 << 20;
+
 fn main() -> ExitCode {
+    #[cfg(not(target_os = "aros"))]
+    let code = cli_main();
+    // An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One
+    // Shell, and whatever an MCP client's process creation gives. Parsing, layout and rendering
+    // overrun that, and the overrun takes the system down with it. The command runs on a thread
+    // with its own stack, so no caller has to know the size; the exit code comes back to the main
+    // task, because ending the process from another thread crashes on AROS.
+    #[cfg(target_os = "aros")]
+    let code = std::thread::Builder::new()
+        .name("deckcraft-cli".into())
+        .stack_size(AROS_STACK)
+        .spawn(cli_main)
+        .map_err(|e| eprintln!("deckcraft-cli: {e}"))
+        .and_then(|worker| worker.join().map_err(|_| eprintln!("deckcraft-cli: the command panicked")))
+        .unwrap_or(ExitCode::FAILURE);
+    // AROS's pthread library joins every thread in its exit handler; rayon's idle global
+    // workers (PDF export and the video decoders run on them) never end by themselves, so a
+    // command that used them could not exit.
+    #[cfg(target_os = "aros")]
+    rayon_core::terminate_global_thread_pool();
+    code
+}
+
+fn cli_main() -> ExitCode {
     let args: Vec<String> = std::env::args().skip(1).collect();
     let rest = args.get(1..).unwrap_or(&[]);
     let asks_help = rest.iter().any(|a| a == "--help" || a == "-h");
