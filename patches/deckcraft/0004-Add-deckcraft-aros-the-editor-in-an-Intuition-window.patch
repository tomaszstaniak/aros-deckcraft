index 0000000000000000000000000000000000000000..b53ed262323bf0a10cf04b98b54eed11c05bdd1f
--- /dev/null
+++ b/apps/deckcraft-aros/src/main.rs
@@ -0,0 +1,308 @@
+//! DeckCraft on AROS.
+//!
+//! Usage: `DeckCraft [--sample] [--show] [--window <w>x<h>] [--screenshot <file.png> [--screenshot-frames <n>]] [files…]`
+//!
+//! The egui interface (`deckcraft-ui-egui`) runs in an Intuition window through egui-aros: winit
+//! and egui-winit for the window and input, a CPU renderer for the pixels, ASL for files. The
+//! engine, presentations and file formats are the same as on the other platforms; this file and
+//! `services` follow the desktop app (apps/deckcraft/src/main.rs). Not here: the localhost
+//! control server (`--control`), audio output and pictures or HTML on the clipboard.
+//!
+//! `--screenshot <file>` writes the window's pixels after `--screenshot-frames` frames (20 by
+//! default) and quits: a way to look at the interface where no display can be watched.
+//! `--window` sets the inner size. `DECKCRAFT_LOG=<file>` appends the log there.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+mod services;
+
+use std::cell::RefCell;
+use std::path::PathBuf;
+use std::rc::Rc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use deckcraft_engine::Session;
+use deckcraft_ui_egui::SlideApp;
+
+/// Longest sleep when nothing asks for a repaint: AutoRecover and finished background opens
+/// still get their turn.
+const IDLE_POLL: Duration = Duration::from_millis(500);
+
+struct Logger;
+
+impl log::Log for Logger {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::max_level()
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            log_line(&format!("deckcraft: {} {}: {}", record.level(), record.target(), record.args()));
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+static LOGGER: Logger = Logger;
+
+/// `DECKCRAFT_LOG`: a file the log (and a panic's message) is appended to instead of the
+/// console. A program started from Workbench has no console, and the AROS Shell cannot redirect
+/// a command's error output, so without it nothing of a failure can be read afterwards.
+static LOG_FILE: std::sync::OnceLock<Option<Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+
+fn log_line(line: &str) {
+    use std::io::Write;
+    let file = LOG_FILE.get_or_init(|| {
+        let path = std::env::var_os("DECKCRAFT_LOG").filter(|p| !p.is_empty())?;
+        std::fs::OpenOptions::new().create(true).append(true).open(path).ok().map(Mutex::new)
+    });
+    match file {
+        Some(file) => {
+            let mut file = file.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            let _ = writeln!(file, "{line}");
+            let _ = file.flush();
+        }
+        None => eprintln!("{line}"),
+    }
+}
+
+fn install_logger() {
+    let level = match std::env::var("RUST_LOG").ok().as_deref().map(str::trim) {
+        Some("trace") => log::LevelFilter::Trace,
+        Some("debug") => log::LevelFilter::Debug,
+        Some("info") => log::LevelFilter::Info,
+        Some("error") => log::LevelFilter::Error,
+        Some("off") => log::LevelFilter::Off,
+        _ => log::LevelFilter::Warn,
+    };
+    // Log every panic before the default hook prints it, so it also reaches the DECKCRAFT_LOG file.
+    let default_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        log::error!("DeckCraft internal error: {info}");
+        default_hook(info);
+    }));
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(level);
+    }
+}
+
+struct Options {
+    files: Vec<String>,
+    sample: bool,
+    show: bool,
+    window: Option<(i32, i32)>,
+    screenshot: Option<String>,
+    screenshot_frames: u64,
+}
+
+const USAGE: &str = "DeckCraft [--sample] [--show] [--window <w>x<h>] [--screenshot <file.png> [--screenshot-frames <n>]] [files...]";
+
+fn parse_args() -> Result<Option<Options>, String> {
+    let mut o = Options { files: Vec::new(), sample: false, show: false, window: None, screenshot: None, screenshot_frames: 20 };
+    let mut args = std::env::args_os().skip(1);
+    while let Some(a) = args.next() {
+        match a.to_str() {
+            Some("--help") | Some("-h") => {
+                println!("{USAGE}");
+                return Ok(None);
+            }
+            Some("--version") | Some("-V") => {
+                println!("deckcraft {}", env!("CARGO_PKG_VERSION"));
+                return Ok(None);
+            }
+            Some("--sample") => o.sample = true,
+            Some("--show") => o.show = true,
+            Some("--control") => return Err("--control: the control server is not available on AROS".to_owned()),
+            Some("--window") => {
+                let v = args.next().map(|p| p.to_string_lossy().into_owned()).unwrap_or_default();
+                let size = v.split_once('x').and_then(|(w, h)| Some((w.parse().ok()?, h.parse().ok()?)));
+                o.window = Some(size.ok_or_else(|| format!("--window: `{v}` is not <width>x<height>"))?);
+            }
+            Some("--screenshot") => o.screenshot = args.next().map(|p| p.to_string_lossy().into_owned()),
+            Some("--screenshot-frames") => {
+                let v = args.next().map(|p| p.to_string_lossy().into_owned()).unwrap_or_default();
+                o.screenshot_frames = v.parse().map_err(|_| format!("--screenshot-frames: `{v}` is not a number"))?;
+            }
+            Some(s) => o.files.push(s.to_owned()),
+            None => return Err(format!("argument is not valid text: {}", a.to_string_lossy())),
+        }
+    }
+    Ok(Some(o))
+}
+
+fn prefs_enabled() -> bool {
+    std::env::var_os("DECKCRAFT_NO_PREFS").is_none()
+}
+
+/// The settings folder (`ui.json`, `prefs.json`, `Recovery`). AROS has no per-user home:
+/// `DeckCraftData` beside the program, like a portable install, or the folder named by
+/// DECKCRAFT_CONFIG_DIR.
+fn config_dir() -> PathBuf {
+    std::env::var_os("DECKCRAFT_CONFIG_DIR").filter(|d| !d.is_empty()).map_or_else(|| PathBuf::from("PROGDIR:DeckCraftData"), PathBuf::from)
+}
+
+fn load_prefs(app: &mut SlideApp) {
+    if !prefs_enabled() {
+        return;
+    }
+    let (ui, prefs) = deckcraft_ui_egui::settings::load(&config_dir());
+    if let Some(ui) = ui {
+        app.ui = ui;
+    }
+    if let Some(prefs) = prefs {
+        app.session.prefs = prefs;
+    }
+}
+
+fn save_prefs(app: &SlideApp) {
+    if prefs_enabled() {
+        deckcraft_ui_egui::settings::save(&config_dir(), &app.ui, &app.session.prefs);
+    }
+}
+
+fn main() {
+    install_logger();
+    let options = match parse_args() {
+        Ok(Some(o)) => o,
+        Ok(None) => return,
+        Err(e) => {
+            eprintln!("deckcraft: {e}");
+            exit(2);
+        }
+    };
+    log::info!("DeckCraft {} ({} {})", env!("CARGO_PKG_VERSION"), std::env::consts::OS, std::env::consts::ARCH);
+    let code = run(options);
+    log::info!("closing: window closed");
+    exit(code);
+}
+
+/// Ends the process. AROS's pthread library joins every thread, detached ones included, in its
+/// exit handler (it must not unload code that other threads still run), and the idle workers
+/// of rayon's global pool never end by themselves. Let them finish first; nothing uses the pool
+/// after this point.
+fn exit(code: i32) -> ! {
+    #[cfg(target_os = "aros")]
+    rayon_core::terminate_global_thread_pool();
+    log::info!("closing: exit({code})");
+    std::process::exit(code);
+}
+
+fn new_app(shared_window: services::SharedWindow, options: &Options) -> SlideApp {
+    let mut app = SlideApp::new(Session::new(), services::aros(shared_window));
+    load_prefs(&mut app);
+    // AutoRecover: reopen what a previous run left unsaved, then keep it current. The engine's
+    // default folder is under HOME, which AROS does not have; it lives in the settings folder.
+    if prefs_enabled() && std::env::var_os("DECKCRAFT_NO_RECOVERY").is_none() {
+        app.session.recovery_dir = Some(config_dir().join("Recovery"));
+        if let Ok(v) = app.session.execute("file.recovery.open", &serde_json::json!({}))
+            && let Some(n) = v.get("opened").and_then(|o| o.as_array()).map(Vec::len).filter(|n| *n > 0)
+        {
+            app.set_status(format!("Recovered {n} unsaved presentation{} from the last session", if n == 1 { "" } else { "s" }));
+        }
+    }
+    app.integrated_titlebar = false;
+    if options.sample
+        && let Err(e) = deckcraft_engine::sample::open_sample(&mut app.session)
+    {
+        log::error!("sample: {e}");
+    }
+    for f in &options.files {
+        if let Err(e) = app.open_path(f) {
+            log::error!("{f}: {e}");
+        }
+    }
+    if options.show {
+        app.start_show(0, false);
+    }
+    app
+}
+
+/// The editor as egui-aros runs it: the desktop app's eframe `logic` and `ui` (its unsaved-changes
+/// prompt cancels the close itself), and the screenshot hook.
+struct Shell {
+    app: SlideApp,
+    shared_window: services::SharedWindow,
+    screenshot: Option<(String, u64)>,
+    done: bool,
+}
+
+impl egui_aros::App for Shell {
+    fn started(&mut self, window: egui_aros::WindowHandle) {
+        *self.shared_window.borrow_mut() = Some(window);
+        log::info!("renderer: {}", egui_aros::renderer_name());
+    }
+
+    // --screenshot needs the frame's pixels; with OpenGL they are read back only then.
+    fn wants_pixels(&self) -> bool {
+        self.screenshot.is_some()
+    }
+
+    fn raw_input_hook(&mut self, raw: &mut egui::RawInput) {
+        self.app.raw_input_hook(raw);
+    }
+
+    fn logic(&mut self, ctx: &egui::Context) {
+        self.app.logic(ctx);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui) {
+        self.app.ui(ui);
+    }
+
+    fn quit_requested(&self) -> bool {
+        self.done
+    }
+
+    fn frame_done(&mut self, report: &egui_aros::FrameReport, renderer: &egui_aros::raster::Renderer) {
+        if let Some((path, frames)) = &self.screenshot
+            && report.frame >= *frames
+        {
+            match write_png(path, renderer) {
+                Ok(()) => eprintln!("deckcraft: wrote {path}"),
+                Err(e) => eprintln!("deckcraft: screenshot {path}: {e}"),
+            }
+            self.done = true;
+        }
+    }
+}
+
+fn run(options: Options) -> i32 {
+    // As large as the screen allows, up to the desktop app's 1440x900; --window sets it exactly.
+    let (sw, sh) = egui_aros::screen_size().map_or((1456, 948), |(w, h)| (w as i32, h as i32));
+    let (w, h) = options.window.unwrap_or((1440.min(sw - 16).max(800), 900.min(sh - 48).max(500)));
+    let (w, h) = (w.max(1) as u32, h.max(1) as u32);
+    let ctx = egui::Context::default();
+    let shared_window: services::SharedWindow = Rc::new(RefCell::new(None));
+    let app = new_app(shared_window.clone(), &options);
+    let mut shell = Shell { app, shared_window, screenshot: options.screenshot.clone().map(|p| (p, options.screenshot_frames)), done: false };
+    let run_options = egui_aros::Options {
+        title: "DeckCraft".to_owned(),
+        inner_size: (w, h),
+        min_inner_size: Some((640, 400)),
+        clear_color: [0xf3, 0xf3, 0xf3],
+        idle_poll: Some(IDLE_POLL),
+        measure_paint: false,
+        // A build drawing with OpenGL says so in the title, so a screenshot names the variant.
+        title_suffix: if cfg!(feature = "glow") { " [GL]".to_owned() } else { String::new() },
+    };
+    let result = egui_aros::run(run_options, ctx, &mut shell);
+    // The services hold the window handle; let go of it with the window.
+    *shell.shared_window.borrow_mut() = None;
+    if let Err(e) = result {
+        eprintln!("deckcraft: {e}");
+        return 1;
+    }
+    log::info!("closing: event loop finished");
+    if shell.screenshot.is_none() {
+        save_prefs(&shell.app);
+    }
+    drop(shell);
+    log::info!("closing: application state dropped");
+    0
+}
+
+fn write_png(path: &str, r: &egui_aros::raster::Renderer) -> Result<(), String> {
+    let img = image::RgbaImage::from_raw(r.width as u32, r.height as u32, r.frame.clone()).ok_or("frame size mismatch")?;
+    img.save_with_format(path, image::ImageFormat::Png).map_err(|e| e.to_string())
+}
diff --git a/apps/deckcraft-aros/src/services.rs b/apps/deckcraft-aros/src/services.rs
new file mode 100644
index 0000000000000000000000000000000000000000..44a71678f199c8bdbb9396da393578cd99e9441e
--- /dev/null
+++ b/apps/deckcraft-aros/src/services.rs
@@ -0,0 +1,92 @@
+//! The platform services the editor needs on AROS: ASL file requesters and file access. The same
+//! contract as the desktop app's `services` function (apps/deckcraft/src/main.rs), without rfd,
+//! arboard and cpal, which have no AROS backend. Text goes through the system clipboard by
+//! egui-aros's own Ctrl/Amiga+C, X, V; pictures and HTML on the clipboard and audio output are
+//! left out (`None`), which the app handles as "not available": media plays silently.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use deckcraft_ui_egui::Services;
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// The requester's title and AmigaDOS pattern (matched without regard to case) for a purpose;
+/// the extensions are the desktop app's filters.
+fn purpose_filter(purpose: &str) -> (&'static str, &'static str) {
+    match purpose {
+        "picture" => ("Insert Picture", "#?.(png|jpg|jpeg|gif|webp|bmp|tif|tiff)"),
+        "audio" => ("Insert Audio", "#?.(wav|mp3|m4a|m4b|aac|flac|ogg|oga|opus|aif|aiff|aifc|caf|wma|weba|mka)"),
+        "video" => ("Insert Video", "#?.(mp4|m4v|mov|webm|mkv|wmv)"),
+        "theme" => ("Browse for Themes", "#?.(thmx|pptx|potx|ppsx)"),
+        _ => ("Open", "#?.(deckcraft|pptx|potx|ppsx|txt|md)"),
+    }
+}
+
+/// The file name part of an AmigaDOS or POSIX path (`a.pptx` for `Work:Talks/a.pptx`).
+pub fn file_part(path: &str) -> &str {
+    path.rsplit(['/', ':']).next().unwrap_or(path)
+}
+
+/// The directory part of an AmigaDOS or POSIX path (`Work:Talks/` for `Work:Talks/a.pptx`).
+pub fn dir_part(path: &str) -> &str {
+    match path.rfind(['/', ':']) {
+        Some(i) => &path[..=i],
+        None => "",
+    }
+}
+
+/// The services for this shell.
+pub fn aros(window: SharedWindow) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let (open_window, save_window) = (window.clone(), window);
+    let (open_dir, save_dir) = (last_dir.clone(), last_dir);
+    Services {
+        pick_open: Some(Box::new(move |purpose: &str| {
+            let win = open_window.borrow().clone()?;
+            let (title, pattern) = purpose_filter(purpose);
+            let dir = open_dir.borrow().clone();
+            let path = request(&win, Select::Open, title, &dir, "", pattern).into_iter().next()?;
+            *open_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_save: Some(Box::new(move |suggested: &str| {
+            let win = save_window.borrow().clone()?;
+            let (dir, file) = (dir_part(suggested).to_string(), file_part(suggested).to_string());
+            let dir = if dir.is_empty() { save_dir.borrow().clone() } else { dir };
+            let path = request(&win, Select::Save, "Save As", &dir, &file, "").into_iter().next()?;
+            *save_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        read: Some(Box::new(|p: &str| std::fs::read(p).map_err(|e| e.to_string()))),
+        write: Some(Box::new(|p: &str, b: &[u8]| std::fs::write(p, b).map_err(|e| e.to_string()))),
+        ..Default::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn splits_amigados_and_posix_paths() {
+        assert_eq!(file_part("Work:Talks/a.pptx"), "a.pptx");
+        assert_eq!(dir_part("Work:Talks/a.pptx"), "Work:Talks/");
+        assert_eq!(dir_part("RAM:a.pptx"), "RAM:");
+        assert_eq!(file_part("a.pptx"), "a.pptx");
+        assert_eq!(dir_part("a.pptx"), "");
+    }
+
+    #[test]
+    fn every_purpose_has_a_pattern() {
+        for p in ["open", "picture", "audio", "video", "theme", "anything"] {
+            let (title, pattern) = purpose_filter(p);
+            assert!(!title.is_empty() && pattern.starts_with("#?.("), "{p}");
+        }
+    }
+}
