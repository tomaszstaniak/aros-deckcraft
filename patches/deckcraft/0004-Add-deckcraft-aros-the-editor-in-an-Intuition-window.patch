+[package]
+name = "deckcraft-aros"
+description = "DeckCraft on AROS: the egui interface drawn into an Intuition window"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+
+# The window, input, rendering and the AROS services come from egui-aros (shared with the
+# WordCraft, PhotoCraft and PdfCraft AROS ports); this crate has no `unsafe` code of its own.
+[lints]
+workspace = true
+
+[features]
+# Draw with OpenGL (gl.library) instead of the CPU renderer; the build needs gl.library to start.
+glow = ["egui-aros/glow"]
+
+[[bin]]
+name = "DeckCraft"
+path = "src/main.rs"
+
+[dependencies]
+deckcraft-engine = { workspace = true }
+deckcraft-ui-egui = { workspace = true }
+egui = { workspace = true, features = ["default_fonts"] }
+# Built from a pinned egui-aros commit with its crate patches: see the port's scripts/dc.py.
+egui-aros = { version = "0.1", features = ["asl"] }
+serde_json = { workspace = true }
+log = { workspace = true }
+# --screenshot writes PNG.
+image = { workspace = true }
+
+# The patched rayon-core (see the port's crate patches) can end the global pool's threads, which
+# AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
diff --git a/apps/deckcraft-aros/src/main.rs b/apps/deckcraft-aros/src/main.rs
