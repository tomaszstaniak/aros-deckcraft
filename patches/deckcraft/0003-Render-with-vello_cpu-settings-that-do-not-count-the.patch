+    let mut ctx = RenderContext::new_with(w, h, crate::render_settings(0));
     let r = Rect::new(0.0, 0.0, w as f64, h as f64);
     ctx.push_clip_layer(&r.to_path(0.1));
     for it in pic.place(r, [0.0; 4]) {
