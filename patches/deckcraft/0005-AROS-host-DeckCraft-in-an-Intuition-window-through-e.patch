new file mode 100644
index 0000000000000000000000000000000000000000..ab7f98860a2102abb789302fce0a6c1beb748544
--- /dev/null
+++ b/apps/deckcraft-aros/src/services.rs
@@ -0,0 +1,135 @@
+//! The platform services the editor uses on AROS: ASL file requesters, file access and pictures
+//! on the system clipboard. The same contract as the desktop app's `services`
+//! (apps/deckcraft/src/main.rs), without rfd, arboard and cpal, which have no AROS backend. Text
+//! goes through the system clipboard by egui-aros (Ctrl/Amiga+C, X, V); HTML on the clipboard and
+//! audio output are left out (`None`), which the app handles as "not available": media plays
+//! silently.
+//!
+//! Paths: the program runs in the -nix path mode; requesters speak DOS names, converted at this
+//! edge (egui_aros::startup).
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use deckcraft_ui_egui::Services;
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+use egui_aros::startup::{dos_to_nix, nix_to_dos};
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// The requester's title and AmigaDOS pattern (matched without regard to case) for a purpose;
+/// the extensions are the desktop app's filters. asl.library copies the pattern into a 257-byte
+/// gadget without a length check (VectorCraft port), so every pattern stays well below that.
+fn purpose_filter(purpose: &str) -> (&'static str, &'static str) {
+    match purpose {
+        "picture" => ("Insert Picture", "#?.(png|jpg|jpeg|gif|webp|bmp|tif|tiff)"),
+        "audio" => ("Insert Audio", "#?.(wav|mp3|m4a|m4b|aac|flac|ogg|oga|opus|aif|aiff|aifc|caf|wma|weba|mka)"),
+        "video" => ("Insert Video", "#?.(mp4|m4v|mov|webm|mkv|wmv)"),
+        "theme" => ("Browse for Themes", "#?.(thmx|pptx|potx|ppsx)"),
+        _ => ("Open", "#?.(deckcraft|pptx|potx|ppsx|txt|md)"),
+    }
+}
+
+/// The file name part of a -nix path (`a.pptx` for `/Work/Talks/a.pptx`).
+fn file_part(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// The drawer part of a -nix path (`/Work/Talks` for `/Work/Talks/a.pptx`).
+fn dir_part(path: &str) -> &str {
+    match path.rfind('/') {
+        Some(0) | None => "",
+        Some(i) => &path[..i],
+    }
+}
+
+fn pick(window: &SharedWindow, select: Select, title: &str, dir: &str, file: &str, pat: &str) -> Option<String> {
+    let win = window.borrow().clone()?;
+    let start = if dir.is_empty() { String::new() } else { nix_to_dos(dir).unwrap_or_default() };
+    let dos = request(&win, select, title, &start, file, pat).into_iter().next()?;
+    match dos_to_nix(&dos) {
+        Ok(p) => Some(p),
+        Err(e) => {
+            log::warn!("requester: {dos}: {e}");
+            None
+        }
+    }
+}
+
+/// The picture on the system clipboard as PNG, the form the app's Paste takes (`None`: no
+/// picture, also when it cannot be read; the reason goes to the log).
+fn clipboard_png() -> Option<Vec<u8>> {
+    match egui_aros::clipboard_image() {
+        egui_aros::ClipboardImage::None => None,
+        egui_aros::ClipboardImage::Pixels { width, height, rgba } => {
+            log::info!("clipboard picture: {width}x{height}");
+            let img = image::RgbaImage::from_raw(width, height, rgba)?;
+            let mut png = Vec::new();
+            match img.write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png) {
+                Ok(()) => Some(png),
+                Err(e) => {
+                    log::warn!("clipboard picture: {e}");
+                    None
+                }
+            }
+        }
+        egui_aros::ClipboardImage::Unreadable(why) => {
+            log::warn!("clipboard picture: {why}");
+            None
+        }
+    }
+}
+
+/// The services for this host.
+pub fn aros(window: SharedWindow) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let (open_window, save_window) = (window.clone(), window);
+    let (open_dir, save_dir) = (last_dir.clone(), last_dir);
+    Services {
+        pick_open: Some(Box::new(move |purpose: &str| {
+            let (title, pattern) = purpose_filter(purpose);
+            let dir = open_dir.borrow().clone();
+            let path = pick(&open_window, Select::Open, title, &dir, "", pattern)?;
+            *open_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_save: Some(Box::new(move |suggested: &str| {
+            let (dir, file) = (dir_part(suggested).to_string(), file_part(suggested).to_string());
+            let dir = if dir.is_empty() { save_dir.borrow().clone() } else { dir };
+            let path = pick(&save_window, Select::Save, "Save As", &dir, &file, "")?;
+            *save_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        read: Some(Box::new(|p: &str| std::fs::read(p).map_err(|e| e.to_string()))),
+        write: Some(Box::new(|p: &str, b: &[u8]| std::fs::write(p, b).map_err(|e| e.to_string()))),
+        clipboard_image: Some(Box::new(clipboard_png)),
+        // One screen: Presenter View needs a second display, which AROS does not offer here.
+        displays: Some(Box::new(|| Some(1))),
+        ..Default::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn path_parts() {
+        assert_eq!(dir_part("/Work/Talks/a.pptx"), "/Work/Talks");
+        assert_eq!(file_part("/Work/Talks/a.pptx"), "a.pptx");
+        assert_eq!(dir_part("/RAM"), "");
+        assert_eq!(dir_part("a.pptx"), "");
+    }
+
+    #[test]
+    fn every_purpose_has_a_pattern_that_fits_the_requester() {
+        for p in ["open", "picture", "audio", "video", "theme", "anything"] {
+            let (title, pattern) = purpose_filter(p);
+            assert!(!title.is_empty() && pattern.starts_with("#?.(") && pattern.len() < 200, "{p}");
+        }
+    }
+}
